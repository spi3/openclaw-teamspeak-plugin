{
  "id": "teamspeak",
  "channels": [
    "teamspeak"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "cliPath": {
        "type": "string"
      },
      "profile": {
        "type": "string"
      },
      "server": {
        "type": "string"
      },
      "nickname": {
        "type": "string"
      },
      "identity": {
        "type": "string"
      },
      "configPath": {
        "type": "string"
      },
      "defaultTo": {
        "type": "string"
      },
      "ingressPath": {
        "type": "string"
      },
      "daemonPollMs": {
        "type": "integer",
        "minimum": 1
      },
      "sessionDefaults": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string"
          },
          "fastMode": {
            "type": "boolean"
          },
          "thinkingLevel": {
            "type": "string"
          }
        }
      },
      "voice": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "always_on",
              "wake_word",
              "push_to_talk",
              "wake_or_ptt"
            ]
          },
          "silenceTimeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "interruptOnSpeech": {
            "type": "boolean"
          },
          "stripWakeWord": {
            "type": "boolean"
          },
          "allowedHandlers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedChannels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedUsers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mediaSocketPath": {
            "type": "string"
          },
          "mirrorTextReplies": {
            "type": "boolean"
          },
          "transcriptionLanguage": {
            "type": "string"
          }
        }
      }
    }
  }
}
